@startuml
title app SELECTビルド アクティビティ図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

start
:Selectを生成;
:RuntimeEntityMetaFactoryで主Entity解析;
:SELECT対象列を初期化;

while (JOIN指定がある?) is (ある)
  :テーブルalias重複を検証;
  :JoinClauseDelegateへ追加;
  :JOIN種別からnullable側を記録;
endwhile (ない)

:WHERE / HAVING / ORDERを受付;
:limit / offsetを受付;
:build開始;
:EntityMeta検証;
:SELECT句を生成;
:FROM句を生成;
:JOIN句を生成;
:WHERE句を生成;
:HAVING指定時はGROUP BY対象を検出;
:GROUP BY / HAVINGを生成;
:ORDER BYを生成;
:LIMIT / OFFSETを生成;
:句定義順に連結;
:join / where / havingのbindValuesを合成;
stop

@enduml
