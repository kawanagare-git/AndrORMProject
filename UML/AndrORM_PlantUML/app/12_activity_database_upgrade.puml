@startuml
title app DBアップグレード アクティビティ図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

start
:登録Entityごとに旧名・新名を決定;
:残存する *_new をDROP;
:標準カラムマッピングを作成;
:resolveColumnMappingsの利用者定義を反映;

repeat
  :PRAGMA table_infoで旧カラムを取得;
  repeat
    if (旧カラムが存在?) then (はい)
      :旧カラム式を転送元に採用;
    else (いいえ)
      if (新カラムはnullable?) then (はい)
        :転送対象から除外;
      else (いいえ)
        if (@MigrationDefaultあり?) then (はい)
          :DEFAULT式を転送元に採用;
        else (いいえ)
          :移行不能として例外;
          stop
        endif
      endif
    endif
  repeat while (次のカラム?) is (ある)
repeat while (次のEntity?) is (ある)

:新テーブルCREATE;
:INSERT INTO 新テーブル SELECT ... FROM 旧テーブル;
:新INDEX作成;
:旧テーブルDROP;
:新テーブルを旧名へRENAME;
stop

@enduml
