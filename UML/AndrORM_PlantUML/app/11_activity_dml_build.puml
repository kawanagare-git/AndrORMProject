@startuml
title app DMLビルド アクティビティ図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

start
:処理種別を選択;
if (INSERT?) then (はい)
  :1件以上のEntityを検証;
  :列一覧とVALUESを展開;
elseif (処理種別はUPDATE?) then (UPDATE)
  :SET指定を検証;
  if (WHEREあり または updateAll?) then (はい)
    :UPDATE / FROM / JOIN / WHERE生成;
  else (いいえ)
    :IllegalArgumentException;
    stop
  endif
elseif (処理種別はDELETE?) then (DELETE)
  if (WHEREあり または deleteAll?) then (はい)
    :DELETE / WHERE生成;
  else (いいえ)
    :IllegalArgumentException;
    stop
  endif
elseif (処理種別はUPSERT?) then (UPSERT)
  :Entity・conflict・SETを検証;
  :ON CONFLICT DO UPDATE生成;
else (ABSERT)
  :Entity・conflictを検証;
  :ON CONFLICT DO NOTHING生成;
endif
:SQL順にbindValuesを再構築;
:queryへ保存;
:isBuildをtrueにする;
stop

@enduml
