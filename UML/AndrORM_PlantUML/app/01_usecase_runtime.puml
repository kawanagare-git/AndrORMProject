@startuml
title appモジュール ユースケース図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

left to right direction
actor "アプリ開発者" as Dev
actor "Androidアプリ" as Client
actor "SQLite" as DB

rectangle "app module" {
  usecase "DDLを生成する" as U1
  usecase "SELECTを構築する" as U2
  usecase "DMLを構築する" as U3
  usecase "SQLを実行する" as U4
  usecase "結果を変換する" as U5
  usecase "DBを作成する" as U6
  usecase "DBを移行する" as U7
  usecase "トランザクションを実行する" as U8
  usecase "SAVEPOINTを実行する" as U9
  usecase "AOPログを出力する" as U10
}

Dev --> U1
Dev --> U2
Dev --> U3
Client --> U4
Client --> U5
Client --> U6
Client --> U7
Client --> U8
Client --> U9
DB --> U4
DB --> U6
DB --> U7

U4 .> U2 : <<include>>
U4 .> U3 : <<include>>
U5 .> U4 : <<include>>
U9 .> U8 : <<extend>>
U10 .> U2 : <<extend>>
U10 .> U3 : <<extend>>

@enduml
