@startuml
title test-support CSVトークン解析アクティビティ図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

start
:source文字列を受け取る;
if (<emptyList>?) then (はい)
  :空Listを返す;
  stop
endif
:文字列を先頭から走査;
while (次の文字あり?) is (はい)
  if (エスケープ文字?) then (はい)
    :次文字を値として追加;
    :必要ならエスケープ状態を温存;
  elseif (対象区切り文字?) then (はい)
    :bufferを結果へ追加;
    :bufferをクリア;
  else
    :文字をbufferへ追加;
  endif
endwhile (いいえ)
:終端bufferを結果へ追加;
:各tokenを型推定変換;
stop

@enduml
