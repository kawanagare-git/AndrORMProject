@startuml
title AndrORM 全体ユースケース図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

left to right direction

actor "アプリケーション開発者" as Developer
actor "ライブラリ保守者" as Maintainer
actor "Gradle / Kotlin Compiler" as BuildSystem
actor "Androidアプリ" as AndroidApp
actor "SQLite" as SQLite
actor "Detekt" as Detekt

rectangle "AndrORM" {
  usecase "テーブル定義Entityを作成する" as UC_Define
  usecase "用途別Entityを自動生成する" as UC_Generate
  usecase "CREATE文を生成する" as UC_Create
  usecase "SELECT文を生成する" as UC_Select
  usecase "INSERT文を生成する" as UC_Insert
  usecase "UPDATE文を生成する" as UC_Update
  usecase "DELETE文を生成する" as UC_Delete
  usecase "UPSERT文を生成する" as UC_Upsert
  usecase "ABSERT文を生成する" as UC_Absert
  usecase "SQLとバインド値を実行する" as UC_Execute
  usecase "Entity / Map / Cursorで取得する" as UC_Result
  usecase "DBを新規作成する" as UC_DbCreate
  usecase "DBをアップグレードする" as UC_Upgrade
  usecase "トランザクションを制御する" as UC_Transaction
  usecase "SAVEPOINTで部分ロールバックする" as UC_Savepoint
  usecase "Entity定義を静的検証する" as UC_Detekt
  usecase "DEFAULT値を検証する" as UC_Default
  usecase "テストデータを変換する" as UC_TestSupport
}

Developer --> UC_Define
Developer --> UC_Create
Developer --> UC_Select
Developer --> UC_Insert
Developer --> UC_Update
Developer --> UC_Delete
Developer --> UC_Upsert
Developer --> UC_Absert
Developer --> UC_Transaction
Developer --> UC_Savepoint

BuildSystem --> UC_Generate
BuildSystem --> UC_Detekt
Detekt --> UC_Detekt

AndroidApp --> UC_Execute
AndroidApp --> UC_Result
AndroidApp --> UC_DbCreate
AndroidApp --> UC_Upgrade
SQLite --> UC_Execute
SQLite --> UC_Result
SQLite --> UC_DbCreate
SQLite --> UC_Upgrade

Maintainer --> UC_TestSupport
Maintainer --> UC_Default

UC_Generate .> UC_Define : <<include>>
UC_Create .> UC_Define : <<include>>
UC_Select .> UC_Define : <<include>>
UC_Insert .> UC_Define : <<include>>
UC_Update .> UC_Define : <<include>>
UC_Delete .> UC_Define : <<include>>
UC_Upsert .> UC_Define : <<include>>
UC_Absert .> UC_Define : <<include>>
UC_Execute .> UC_Select : <<extend>>
UC_Execute .> UC_Insert : <<extend>>
UC_Execute .> UC_Update : <<extend>>
UC_Execute .> UC_Delete : <<extend>>
UC_Execute .> UC_Upsert : <<extend>>
UC_Execute .> UC_Absert : <<extend>>
UC_Result .> UC_Execute : <<include>>
UC_Upgrade .> UC_Default : <<include>>
UC_Savepoint .> UC_Transaction : <<extend>>

@enduml
