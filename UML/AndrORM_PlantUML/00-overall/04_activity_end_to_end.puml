@startuml
title AndrORM 開発・実行全体アクティビティ図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

start
:テーブル定義data classを作成;
:@Table / @Column等を付与;
:@Projection / @Projectionsを付与;

:Gradleビルド;
:KSPが定義を解析;
if (定義は妥当か?) then (はい)
  :用途別Entityを生成;
else (いいえ)
  :KSPエラーまたは警告を出力;
  stop
endif

:アプリケーションコードでBuilderを生成;
if (処理種別?) then (CREATE)
  :CreateでDDL生成;
elseif (処理種別はSELECT?) then (SELECT)
  :Select DSLで抽出条件を構築;
elseif (処理種別はINSERT?) then (INSERT)
  :InsertへEntityを追加;
elseif (処理種別はUPDATE?) then (UPDATE)
  :SETとWHEREまたはupdateAllを指定;
elseif (処理種別はDELETE?) then (DELETE)
  :WHEREまたはdeleteAllを指定;
elseif (処理種別はUPSERT?) then (UPSERT)
  :Entity / conflict / SETを指定;
else (ABSERT)
  :Entity / conflictを指定;
endif

:buildでSQL生成;
:bindValuesを取得;
:AndrOrmDatabaseHelperへ実行依頼;
:SQLiteが処理;
if (SELECTか?) then (はい)
  :Cursorを取得;
  if (戻り形式?) then (Cursor)
    :Cursorを返す;
  elseif (戻り形式はMap?) then (Map)
    :Mapへ変換;
  else (Entity)
    :MapからEntityを復元;
  endif
else (いいえ)
  :更新件数を返す;
endif
stop

@enduml
