@startuml
title AndrORM 主要オブジェクト状態図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

state "Query Builder" as QB {
  [*] --> 未設定
  未設定 --> 変更済み : set / where / join / addEntity
  変更済み --> ビルド済み : build成功
  ビルド済み --> ビルド済み : build\nキャッシュ返却
  ビルド済み --> 変更済み : SQLへ影響する操作
  変更済み --> 検証失敗 : 必須句不足
  検証失敗 --> 変更済み : 設定を追加
}

state "Database" as DB {
  [*] --> 未作成
  未作成 --> 作成済み : onCreate
  作成済み --> 移行中 : onUpgrade
  移行中 --> 作成済み : 全テーブル移行成功
  移行中 --> 移行失敗 : SQL例外
}

state "Transaction / Savepoint" as TX {
  [*] --> TransactionActive : beginTransaction
  TransactionActive --> SavepointActive : SAVEPOINT
  SavepointActive --> SavepointReleased : block成功 / RELEASE
  SavepointActive --> SavepointRolledBack : block例外 / ROLLBACK TO
  SavepointRolledBack --> SavepointReleased : RELEASE
  TransactionActive --> Committed : setTransactionSuccessful + end
  TransactionActive --> RolledBack : 例外伝播 + end
}

@enduml
