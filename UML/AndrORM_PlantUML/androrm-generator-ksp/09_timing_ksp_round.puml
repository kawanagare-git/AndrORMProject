@startuml
title androrm-generator-ksp Roundタイミング図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

concise "KSP Round" as Round
concise "PropsProcessor" as Processor
concise "Validation" as Validation
concise "Writer" as Writer

@0
Round is Start
Processor is Initialize
Validation is Idle
Writer is Idle

@10
Round is Resolve
Processor is Extract

@20
Processor is Parse
Validation is Running

@35
Validation is Passed
Writer is Generate

@50
Writer is Written
Processor is ReturnDeferred

@60
Round is NextOrFinish
Processor is Idle
Validation is Idle
Writer is Idle

@enduml
