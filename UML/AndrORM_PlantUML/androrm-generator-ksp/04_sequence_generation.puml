@startuml
title androrm-generator-ksp Entity生成シーケンス図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

autonumber
participant KSP
participant PropsProcessorProvider as Provider
participant PropsProcessor as Processor
participant ProjectionExtractor as Extractor
participant ProjectionArgumentParser as Parser
participant ProjectionValidator as Validator
participant KspEntityMetaFactory as MetaFactory
participant InterfaceResolver as Interfaces
participant ColumnPropertyFactory as ColumnFactory
participant FunctionPropertyFactory as FunctionFactory
participant DataClassWriter as Writer
participant CodeGenerator as Output

KSP -> Provider : create(environment)
Provider -> Processor : new
Provider --> KSP : SymbolProcessor

KSP -> Processor : process(resolver)
Processor -> Extractor : findProjectionClasses()
Extractor --> Processor : KSClassDeclaration群
loop 各クラス / 各Projection
  Processor -> Parser : parse(annotation)
  Parser --> Processor : ProjectionDefinition
  Processor -> Validator : validateProperties /\nvalidateAggregateConflicts
  Processor -> MetaFactory : create(classDeclaration)
  MetaFactory --> Processor : EntityMeta
  Processor -> Interfaces : resolve package / interfaces
  Interfaces --> Processor : package + TypeName群
  Processor -> ColumnFactory : create(projected properties)
  ColumnFactory --> Processor : GeneratedProperty群
  Processor -> FunctionFactory : createAll(function projections)
  FunctionFactory --> Processor : GeneratedProperty群
  Processor -> Writer : write(...)
  Writer -> Output : createNewFile + KotlinPoet.writeTo
end
Processor --> KSP : deferred symbols

@enduml
