@startuml
title androrm-generator-ksp ビルド時配置図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

component "Kotlin compile task" as KotlinCompile

node "Gradle Daemon" {
  component "KSP Gradle Plugin" as Plugin
  artifact "app source set" as Sources
  artifact "androrm-generator-ksp.jar" as ProcessorJar
  component "PropsProcessorProvider" as Provider
  component "PropsProcessor" as Processor
  folder "build/generated/ksp/debug/kotlin" as Generated
  folder "build/androrm-ksp-logs" as Logs
}

Sources --> Plugin
ProcessorJar --> Plugin
Plugin --> Provider
Provider --> Processor
Processor --> Generated
Processor --> Logs
Generated --> KotlinCompile

@enduml
