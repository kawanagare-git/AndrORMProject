@startuml
title androrm-generator-ksp Processor状態図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

[*] --> Created : Provider.create
Created --> Processing : process(resolver)
Processing --> Deferred : 未解決Symbolあり
Deferred --> Processing : 次Round
Processing --> ErrorRecorded : 定義エラー
ErrorRecorded --> Processing : 次のProjection
Processing --> Generated : ソース出力成功
Generated --> Processing : 次のProjection
Processing --> Finished : finish()
Processing --> Aborted : onError()
Deferred --> Finished : finish()
Finished --> [*] : logger.close
Aborted --> [*] : logger.close

@enduml
