left to right direction
package "root" {
  object Constants
  class PropsProcessor
  class PropsProcessorProvider
}
package "factory" {
  class ColumnPropertyFactory
  class FunctionPropertyFactory
  class GeneratedProperty
  class TableAnnotationFactory
}
package "helper" {
  class AnnotationHelper
  class ImportHelper
  class TypeHelper
}
package "logging" {
  class CompositeLogger
  object CreateLogger
  object DefaultLogMessageGenerator
  class FileDelegatingLogger
  class KspDelegatingLogger
  object LogUtils
}
package "meta" {
  class KspEntityMetaFactory
}
package "projectoin" {
  class ProjectionArgumentParser
  class ProjectionDefinition
  class ProjectionExtractor
  class ProjectionValidator
}
package "resolver" {
  class InterfaceResolver
}
package "validator" {
  class ColumnDefaultValueValidator
  class MigrationDefaultValueValidator
}
package "writer" {
  class DataClassWriter
}

@enduml
