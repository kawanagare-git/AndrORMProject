@startuml
title androrm-detekt-rules 解析シーケンス図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

autonumber
participant Detekt
participant AndrOrmRuleSetProvider as Provider
participant AndrOrmEntityRefRule as EntityRule
participant AndrOrmDuplicateTableNameRule as DupRule
participant "Kotlin PSI" as PSI
participant AndrOrmLogger as Logger

Detekt -> Provider : instance(config)
Provider -> Logger : initOnce()
Provider --> Detekt : RuleSet(2 rules)

Detekt -> EntityRule : visitKtFile(file)
EntityRule -> PSI : Select呼出しチェーン探索
EntityRule -> PSI : 主Entity / JOIN Entity抽出
EntityRule -> PSI : where/on等のCallableReference抽出
alt 許可Entity外の参照
  EntityRule -> Detekt : report(CodeSmell)
end

Detekt -> DupRule : visitKtFile(file)
DupRule -> PSI : source root探索
DupRule -> PSI : 同一source setの.kt走査
DupRule -> PSI : @Table名抽出
alt 大文字小文字無視で重複
  DupRule -> Detekt : report(CodeSmell)
end

@enduml
