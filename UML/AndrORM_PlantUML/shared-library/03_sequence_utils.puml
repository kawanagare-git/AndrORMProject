@startuml
title shared-library Utility呼出しシーケンス図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

autonumber
participant Caller
participant Utils

Caller -> Utils : value.isNull()
Utils --> Caller : value == null

Caller -> Utils : value.isNotNull()
Utils --> Caller : value != null

Caller -> Utils : result.isUnit()
Utils --> Caller : result === Unit

Caller -> Utils : returnType.isVoid()
Utils --> Caller : void / Void判定

@enduml
