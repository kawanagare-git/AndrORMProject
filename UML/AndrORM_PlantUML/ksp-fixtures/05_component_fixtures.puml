@startuml
title ksp-fixtures コンポーネント図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

component "invalid-select fixture sources" as Fixtures
component "Kotlin Compile Testing" as CompileTest
component "KSP Plugin" as KSP
component "androrm-generator-ksp" as Processor
component "androrm-common" as Common

CompileTest --> Fixtures
CompileTest --> KSP
KSP --> Processor
Fixtures --> Common
Processor --> Common

@enduml
