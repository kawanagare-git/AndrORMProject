@startuml
title ksp-fixtures 異常系検証シーケンス図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

autonumber
participant "Compile Test" as Test
participant "Invalid Fixture Source" as Fixture
participant PropsProcessor as Processor
participant EntityMetaValidator as Validator
participant "KSP Logger" as Logger

Test -> Fixture : 対象ソースを選択
Test -> Processor : compile()
Processor -> Fixture : @Projection / property解析
Processor -> Validator : validate(EntityMeta)
Validator --> Processor : errors / warnings
alt error fixture
  Processor -> Logger : error(message, symbol)
  Processor --> Test : compilation failed
else warning fixture
  Processor -> Logger : warning(message, symbol)
  Processor --> Test : compilation success + warning
end

@enduml
