@startuml
title ksp-fixtures ユースケース図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

left to right direction
actor "KSPテスト" as Test
actor "PropsProcessor" as Processor

rectangle "ksp-fixtures / invalid-select" {
  usecase "全列hiddenを検証する" as U1
  usecase "Column/Function二重定義を検証する" as U2
  usecase "SELECT alias重複を検証する" as U3
  usecase "hiddenを含む不自然な定義を検証する" as U4
}

Test --> U1
Test --> U2
Test --> U3
Test --> U4
Processor --> U1
Processor --> U2
Processor --> U3
Processor --> U4

@enduml
