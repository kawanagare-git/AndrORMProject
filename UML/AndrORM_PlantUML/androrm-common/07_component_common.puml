@startuml
title androrm-common コンポーネント図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

component "Projection Annotations" as Proj
component "Database Annotations" as DbAnn
component "DML Entity Interfaces" as Interfaces
component "Entity Metadata" as Meta
component "SQL Function Definitions" as Functions
component "DEFAULT Validator" as Default
component "Logging Contract" as Logging
component "SupportFunction" as Support
component "Constants / Messages" as Const
component "shared-library" as Shared

Proj --> Interfaces
DbAnn --> Meta
Meta --> DbAnn
Functions --> Interfaces
Default --> Const
Logging --> Const
Support --> DbAnn
Support --> Interfaces
Logging --> Shared

@enduml
