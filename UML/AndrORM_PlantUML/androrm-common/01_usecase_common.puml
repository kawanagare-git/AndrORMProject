@startuml
title androrm-common ユースケース図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

left to right direction
actor "Entity定義者" as Dev
actor "KSP" as KSP
actor "app runtime" as Runtime
actor "Detekt rule" as Detekt

rectangle "androrm-common" {
  usecase "テーブル・カラムを注釈する" as U1
  usecase "Projectionを定義する" as U2
  usecase "用途別Entity契約を表す" as U3
  usecase "EntityMetaを検証する" as U4
  usecase "DEFAULT値を検証する" as U5
  usecase "SQL関数を定義する" as U6
  usecase "共通ログを出力する" as U7
  usecase "命名・リフレクションを支援する" as U8
}

Dev --> U1
Dev --> U2
KSP --> U2
KSP --> U4
KSP --> U5
KSP --> U6
Runtime --> U1
Runtime --> U3
Runtime --> U6
Runtime --> U8
Detekt --> U1

@enduml
