@startuml
title Unit Test実行シーケンス図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

autonumber
participant Gradle
participant "JUnit Platform" as JUnit
participant "ParameterizedTest" as Test
participant "test-support converter" as Converter
participant "AndrORM class under test" as SUT

Gradle -> JUnit : testDebugUnitTest / test
JUnit -> Test : discover
opt @CsvSource + @ConvertWith
  JUnit -> Converter : convert(source)
  Converter --> JUnit : typed argument
end
JUnit -> Test : invoke(arguments)
Test -> SUT : build / validate / convert
SUT --> Test : actual
Test -> Test : assert expected
Test --> JUnit : pass / fail
JUnit --> Gradle : XML / HTML report

@enduml
