@startuml
title Android Test配置図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

node "Development PC" {
  component "Gradle connectedDebugAndroidTest" as Gradle
  folder "app/build/outputs/androidTest-results" as Results
}

node "Pixel_9_Pro_API_34\nAndroid 14" as Device {
  artifact "app-debug.apk" as AppApk
  artifact "app-debug-androidTest.apk" as TestApk
  component "AndroidJUnitRunner" as Runner
  database "test SQLite DB" as DB
  folder "test output / CSV" as CSV
}

Gradle --> AppApk
Gradle --> TestApk
TestApk --> Runner
Runner --> AppApk
AppApk --> DB
Runner --> CSV
Runner --> Results

@enduml
