@startuml
title テスト実行タイミング図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

concise "Gradle" as Gradle
concise "Unit Tests" as Unit
concise "Emulator" as Emulator
concise "Android Tests" as Android
concise "Reports" as Reports

@0
Gradle is Configure
Unit is Idle
Emulator is Stopped
Android is Idle
Reports is Empty

@10
Gradle is UnitTestTasks
Unit is Running

@50
Unit is Passed
Gradle is StartEmulator
Emulator is Booting

@80
Emulator is Ready
Gradle is Instrumentation
Android is Step01_26

@140
Android is Passed
Gradle is CollectResults
Reports is Generate

@150
Gradle is Finished
Unit is Idle
Emulator is Ready
Android is Idle
Reports is Ready

@enduml
