@startuml
title テスト構成コンポーネント図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

component "app Unit Tests" as AppUT
component "common Unit Tests" as CommonUT
component "KSP Compile Tests" as KspUT
component "Detekt Rule Tests" as DetektUT
component "shared Unit Tests" as SharedUT
component "Android Instrumentation Tests" as AndroidIT
component "test-support" as Support
component "ksp-fixtures" as Fixtures
component "JUnit5 / Mockito" as J5
component "JUnit4 / AndroidX Test" as J4
component "AndrORM Runtime" as Runtime

AppUT --> J5
CommonUT --> J5
KspUT --> J5
DetektUT --> J5
SharedUT --> J5
AndroidIT --> J4

AppUT --> Support
CommonUT --> Support
KspUT --> Fixtures
AndroidIT --> Runtime

@enduml
