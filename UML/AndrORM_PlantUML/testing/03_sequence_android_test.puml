@startuml
title Android Test実行シーケンス図
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment left
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #9E9E9E
skinparam ArrowColor #455A64
skinparam activityDiamondBackgroundColor #ECEFF1
skinparam activityDiamondBorderColor #455A64

autonumber
participant Gradle
participant "AndroidJUnitRunner" as Runner
participant "Step Test" as Test
participant AndrOrmDatabaseHelper as Helper
database "SQLite on Device" as DB
participant "CSV Export" as Export

Gradle -> Runner : connectedDebugAndroidTest
Runner -> Test : step01 ... step26
Test -> Helper : DB作成 / DML / SELECT / Upgrade
Helper -> DB : SQL
DB --> Helper : result
Helper --> Test : Entity / Map / row count
Test -> Test : assert
Test -> Export : 各テスト終了時に全テーブル出力
Export --> Test : CSV files
Test --> Runner : result
Runner --> Gradle : instrumentation report

@enduml
