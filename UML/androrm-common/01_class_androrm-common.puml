    --
    +create()
    +log()
  }
}

package "jp.pgw.lab78.androrm.common.logging.aop" {
  class "InfoLog" as InfoLog {
  }
  class "TraceLog" as TraceLog {
  }
}

package "jp.pgw.lab78.androrm.common.logging.interfaces" {
  interface "AndrOrmLoggerLike" as AndrOrmLoggerLike {
    +create()
    +log()
  }
  interface "LoggerLike" as LoggerLike {
    +logInfo()
    +logInfoEntered()
    +logInfoExiting()
    +logWarning()
    +logError()
    +logDebug()
    +logTraceEntered()
    +logTraceExiting()
  }
}

package "jp.pgw.lab78.androrm.common.meta" {
