package "jp.pgw.lab78.androrm.common" {
  object "Constants" as Constants {
  }
  class "DMLInterfaceEnum" as DMLInterfaceEnum {
    +kClass: KClass
    +interfaceFQN: String
  }
  class "Element" as Element {
    +tag: String
  }
  object "EntityConstants" as EntityConstants {
  }
  class "IndexType" as IndexType {
    +query: String
  }
  class "LogPhase" as LogPhase {
    +tag: String
  }
  class "LogicalOperator" as LogicalOperator {
    +query: String
  }
  object "MessageConstants" as MessageConstants {
  }
  class "ModuleLabel" as ModuleLabel {
    +tag: String
    +logFilename: String
  }
  class "PackageInterfaceRelation" as PackageInterfaceRelation {
    +relation: String
  }
}

package "jp.pgw.lab78.androrm.common.annotation" {
  class "ColumnProjection" as ColumnProjection {
    +property: String
    +hideFromSelect: Boolean
  }
  class "EntityPackageInfo" as EntityPackageInfo {
    +basePackage: String
    +selectPackage: String
    +insertPackage: String
    +updatePackage: String
    +upsertPackage: String
    +absertPackage: String
    +deletePackage: String
  }
  class "FunctionProjection" as FunctionProjection {
    +function: ColumnFunction
    +args: Array
    +alias: String
    +returnHint: AndrOrmValueType
    +hideFromSelect: Boolean
    +raw: String
  }
  class "Projection" as Projection {
    +entityNameExtend: String
    +aliasExtend: String
    +properties: Array
    +functions: Array
    +commonInterface: Array
    +customInterface: Array
  }
  class "Projections" as Projections {
    +value: Array
  }
}

package "jp.pgw.lab78.androrm.common.database" {
  object "ColumnAnnotationResolver" as ColumnAnnotationResolver {
    +find()
  }
  class "ColumnDefinition" as ColumnDefinition {
    +name: String
    +alias: String
    +hideFromSelect: Boolean
    +default: String
  }
  class "InterfaceColumnAnnotation" as InterfaceColumnAnnotation {
    +interfaceClass: KClass
    +annotation: Column
  }
  object "SupportFunction" as SupportFunction {
    +buildAlias()
    +getPropertyValue()
  }
}

package "jp.pgw.lab78.androrm.common.database.annotation" {
  class "Column" as Column {
    +name: String
    +alias: String
    +hideFromSelect: Boolean
    +default: String
  }
  class "ColumnOldName" as ColumnOldName {
    +name: String
  }
  class "Function" as Function {
    +columnFunction: ColumnFunction
    +alias: String
    +args: Array
    +raw: String
    +hideFromSelect: Boolean
  }
  class "Index" as Index {
    +name: String
    +properties: Array
  }
  class "MigrationDefault" as MigrationDefault {
    +value: String
  }
  class "PrimaryKey" as PrimaryKey {
  }
  class "Table" as Table {
    +name: String
    +alias: String
  }
  class "Unique" as Unique {
    +name: String
    +properties: Array
  }
  class "View" as View {
    +name: String
    +alias: String
  }
}

package "jp.pgw.lab78.androrm.common.database.columns.base" {
  class "AndrOrmValueType" as AndrOrmValueType {
    +type: KClass
  }
}

package "jp.pgw.lab78.androrm.common.database.columns.controller" {
  object "SqlDefaultValueValidator" as SqlDefaultValueValidator {
    +dateTimeSpaceFormatter: DateTimeFormatter
    --
    +isValid()
    +normalize()
  }
  class "SqlValueType" as SqlValueType {
    +valueType: AndrOrmValueType
    +regex: String
  }
}

package "jp.pgw.lab78.androrm.common.database.columns.interfaces" {
  interface "ColumnControllerModel" as ColumnControllerModel {
    +toColumnValue()
  }
}

package "jp.pgw.lab78.androrm.common.database.function" {
  class "ColumnFunction" as ColumnFunction {
    +argumentArity: ArgumentArity
    +returnType: String
    +functionName: String
    --
    +getReturnType()
    +build()
    +widerType()
    +resolveSumReturnType()
  }
  class "SqlAggregateFunction" as SqlAggregateFunction {
    +getReturnType()
    +build()
  }
  class "SqlScalarFunction" as SqlScalarFunction {
    +getReturnType()
    +build()
  }
}

